# Database. Leave unset and it falls back to a SQLite file (command-center.db).
# Set a Postgres URL only if we ever outgrow one VM.
DATABASE_URL=

# Claude. Leave ANTHROPIC_API_KEY unset to use an `ant auth login` profile instead —
# the SDK resolves ANTHROPIC_API_KEY, then ANTHROPIC_AUTH_TOKEN, then the profile.
# A set key silently wins over a profile, so unset it if you mean to use the profile.
ANTHROPIC_API_KEY=
# Optional: pick a named `ant` profile for this app (see Settings tab).
ANTHROPIC_PROFILE=
EXTRACT_MODEL=claude-opus-5

# Session signing key. Generated and written here automatically on first run if absent.
SECRET_KEY=

# Slack. From the app you create with slack/manifest.yaml.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# EMOH — the ops hub. One of these: a read-only GitHub token for the repo, or a local checkout path.
GITHUB_TOKEN=
EMOH_PATH=

# How often the scheduler polls EMOH for new meetings and extracts them (minutes). 0 = off.
EXTRACT_INTERVAL_MIN=60
