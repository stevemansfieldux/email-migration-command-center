# Database. Railway injects DATABASE_URL automatically when you add Postgres.
# Leave unset locally and it falls back to a SQLite file.
DATABASE_URL=

# Task extraction. Without this the ingest endpoints return 503 rather than crashing.
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-sonnet-5

# Shared secret for the ingest endpoints. Any long random string.
INGEST_TOKEN=

# Slack. From the app you create with slack/manifest.yaml.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
