[Unit]
Description=Command Centre
After=network-online.target
Wants=network-online.target

[Service]
User=cc
Group=cc
WorkingDirectory=/srv/cc/app
EnvironmentFile=-/srv/cc/app/.env
ExecStart=/srv/cc/app/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
